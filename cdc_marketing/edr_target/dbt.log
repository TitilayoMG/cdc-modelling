{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"dbt_databricks_version\": \"1.12.5\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"3fcdbbc1-a28d-4cf8-8d99-33ff70903be1\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"3fcdbbc1-a28d-4cf8-8d99-33ff70903be1\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n    with ordered_run_results as (\n      select\n        *,\n        row_number() over (partition by unique_id order by run_results.generated_at desc) as row_number\n      from `bronze_production`.`cdc_staging`.`dbt_run_results` run_results\n      join `bronze_production`.`cdc_staging`.`dbt_models` using (unique_id)\n    ),\n\n    latest_run_results as (\n      select *\n      from ordered_run_results\n      where row_number = 1\n    )\n\n    select unique_id, invocation_id from latest_run_results\n  \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "3fcdbbc1-a28d-4cf8-8d99-33ff70903be1", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"dbt_databricks_version\": \"1.12.5\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"3fcdbbc1-a28d-4cf8-8d99-33ff70903be1\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"3fcdbbc1-a28d-4cf8-8d99-33ff70903be1\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n    with ordered_run_results as (\n      select\n        *,\n        row_number() over (partition by unique_id order by run_results.generated_at desc) as row_number\n      from `bronze_production`.`cdc_staging`.`dbt_run_results` run_results\n      join `bronze_production`.`cdc_staging`.`dbt_models` using (unique_id)\n    ),\n\n    latest_run_results as (\n      select *\n      from ordered_run_results\n      where row_number = 1\n    )\n\n    select unique_id, invocation_id from latest_run_results\n  \n\n  ", "name": "SQLQuery", "pid": 1055, "thread": "MainThread", "ts": "2026-09-23T20:13:19.888143Z"}}
